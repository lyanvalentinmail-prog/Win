{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lyanvalentinmail-prog/Win/config/vm.schema.json",
  "title": "Configuracion de despliegue de la VM de gaming con Windows",
  "description": "Schema de config/vm.json (y config/vm.example.json). Valida proveedor, tamano, edicion de Windows, acceso remoto, apps y opciones de gaming. Ningun campo admite credenciales: las contraseñas se generan o se leen de variables de entorno/secretos del proveedor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "provider",
    "region",
    "vm",
    "windows",
    "remote",
    "apps",
    "security",
    "cost"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$",
      "description": "Nombre de la VM / grupo de recursos. Minusculas, digitos y guiones (compatible con Azure y AWS)."
    },
    "provider": {
      "enum": [
        "azure",
        "aws",
        "libvirt"
      ],
      "description": "azure/aws = nube publica de pago. libvirt = hypervisor local propio."
    },
    "region": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "resourceGroup": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "tags": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9_.:-]{1,512}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 256
      },
      "maxProperties": 15
    },
    "vm": {
      "$ref": "#/$defs/vm"
    },
    "gpu": {
      "$ref": "#/$defs/gpu"
    },
    "windows": {
      "$ref": "#/$defs/windows"
    },
    "remote": {
      "$ref": "#/$defs/remote"
    },
    "gaming": {
      "$ref": "#/$defs/gaming"
    },
    "apps": {
      "$ref": "#/$defs/apps"
    },
    "security": {
      "$ref": "#/$defs/security"
    },
    "power": {
      "$ref": "#/$defs/power"
    },
    "cost": {
      "$ref": "#/$defs/cost"
    },
    "$schema": {
      "type": "string",
      "description": "Apunta a este propio schema para el autocompletado del editor."
    }
  },
  "$defs": {
    "vm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size",
        "vcpus",
        "ramGiB",
        "osDiskGiB"
      ],
      "properties": {
        "size": {
          "type": "string",
          "minLength": 3,
          "description": "SKU exacto del proveedor, p.ej. Standard_NV6ads_A10_v5, g4dn.xlarge o (libvirt) 'host:custom'."
        },
        "vcpus": {
          "type": "integer",
          "minimum": 2,
          "maximum": 96
        },
        "ramGiB": {
          "type": "integer",
          "minimum": 4,
          "maximum": 1024
        },
        "osDiskGiB": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4095,
          "description": "Windows + apps + 1 launcher de juegos. 128 GiB recomendado."
        },
        "osDiskSku": {
          "enum": [
            "StandardSSD",
            "PremiumSSD",
            "PremiumSSDv2",
            "gp3",
            "io2",
            "qcow2"
          ],
          "default": "PremiumSSD"
        },
        "dataDiskGiB": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32767,
          "default": 256,
          "description": "Disco persistente D: para juegos, documentos y perfiles. 0 = sin disco de datos."
        },
        "dataDiskSku": {
          "enum": [
            "StandardSSD",
            "PremiumSSD",
            "PremiumSSDv2",
            "gp3",
            "io2",
            "qcow2"
          ],
          "default": "PremiumSSD"
        },
        "useEphemeralOsDisk": {
          "type": "boolean",
          "default": false,
          "description": "OS en el SSD local del host (mas rapido, se pierde al deallocate). No usar si se necesita persistencia del sistema."
        },
        "spot": {
          "type": "boolean",
          "default": false,
          "description": "Spot/low priority: mas barato pero la VM puede ser interrumpida. Incompatible con sesiones de juego largas."
        },
        "bootDiagnostics": {
          "type": "boolean",
          "default": true
        },
        "hyperVGeneration": {
          "enum": [
            1,
            2
          ],
          "default": 2,
          "description": "Generacion 2 (UEFI + Secure Boot + vTPM) es obligatoria para Windows 11."
        },
        "encryptedHostCache": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "paravirtual",
            "passthrough"
          ],
          "description": "none = VM sin GPU (solo escritorio/RemoteApp). paravirtual = vGPU/GPU particionada del proveedor (Azure NV*, AWS G*). passthrough = GPU fisica asignada a la VM (KVM/Hyper-V local)."
        },
        "driver": {
          "enum": [
            "nvidia-grid",
            "nvidia-tesla",
            "amd-pro",
            "intel",
            "none"
          ],
          "default": "none"
        },
        "installDriverFrom": {
          "enum": [
            "azure-extension",
            "official-url",
            "preinstalled"
          ],
          "default": "azure-extension"
        },
        "hardwareEncoderRequired": {
          "type": "boolean",
          "default": true,
          "description": "Si es true y no hay codificador de video por hardware, el canal de juego (Sunshine) queda deshabilitado por el auditor: no se simula."
        },
        "instaladorUrl": {
          "type": "string",
          "pattern": "^https://",
          "description": "URL oficial del instalador de driver (solo gpu.mode=passthrough / BYOI). Debe estar en apps/sources.json y verificarse con instaladorSha256."
        },
        "instaladorSha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$",
          "description": "SHA-256 esperado del instalador. Obligatorio si se declara instaladorUrl."
        }
      }
    },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "username"
      ],
      "properties": {
        "edition": {
          "enum": [
            "windows-server-2025-desktop",
            "windows-server-2022-desktop",
            "windows-11-pro",
            "windows-11-enterprise",
            "windows-10-enterprise-multi-session",
            "custom"
          ]
        },
        "customImageRef": {
          "type": "string",
          "description": "Solo con edition=custom: id de AMI / imagen gestionada / ruta de ISO."
        },
        "username": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{2,19}$",
          "description": "Usuario local de administracion. La contrasena NUNCA se guarda aqui: se genera o se lee de un secreto."
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "default": "es-ES"
        },
        "timezone": {
          "type": "string",
          "default": "GMT Standard Time"
        },
        "disableAutoUpdates": {
          "type": "boolean",
          "default": false,
          "description": "No se recomienda. Si se activa, el auditor lo marca como riesgo."
        },
        "autoLogon": {
          "type": "boolean",
          "default": false,
          "description": "Necesario solo para el canal Sunshine/Moonlight si se quiere sesion de consola desatendida. Guarda la sesion en la consola fisica."
        },
        "wallpaper": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "enum": [
                "default",
                "local-file",
                "url",
                "solid-color"
              ],
              "default": "default"
            },
            "path": {
              "type": "string"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "style": {
              "enum": [
                "fill",
                "fit",
                "stretch",
                "tile",
                "center"
              ],
              "default": "fill"
            }
          }
        },
        "theme": {
          "enum": [
            "light",
            "dark",
            "system"
          ],
          "default": "dark"
        },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "scaling": {
          "type": "integer",
          "minimum": 100,
          "maximum": 300,
          "multipleOf": 25,
          "default": 100,
          "description": "Escala del escritorio en % (100,125,150,...)."
        }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "allowedCidrs"
      ],
      "properties": {
        "type": {
          "enum": [
            "rdp-windows-app",
            "rdp-gateway",
            "tailscale-rdp",
            "none"
          ],
          "default": "rdp-windows-app",
          "description": "Todos son RDP: 'Windows App' de Microsoft solo habla RDP. Las variantes cambian como se expone el puerto."
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 3389
        },
        "allowedCidrs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$|^::/0$"
          },
          "description": "IP publica de tu operador/movil. [] = no exponer 3389 (obligatorio si tunnel != none)."
        },
        "requireNla": {
          "type": "boolean",
          "default": true
        },
        "tunnel": {
          "enum": [
            "none",
            "bastion",
            "ssh",
            "tailscale",
            "vpn"
          ],
          "default": "none"
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quality": {
              "enum": [
                "low-latency",
                "balanced",
                "fidelity"
              ],
              "default": "balanced"
            },
            "colorDepth": {
              "enum": [
                16,
                24,
                32
              ],
              "default": 32
            },
            "avc444": {
              "type": "boolean",
              "default": true,
              "description": "H.264/AVC 4:4:4: requiere GPU + WDDM en el host; el auditor lo verifica."
            },
            "hardwareEncoding": {
              "type": "boolean",
              "default": true
            },
            "udp": {
              "type": "boolean",
              "default": true
            },
            "maxMonitors": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16,
              "default": 4
            },
            "audio": {
              "enum": [
                "play",
                "no-play",
                "remote-render"
              ],
              "default": "play",
              "description": "Redireccion de audio del servidor al cliente: depende del cliente (Windows App la soporta en Android)."
            },
            "clipboard": {
              "type": "boolean",
              "default": true
            },
            "driveRedirection": {
              "type": "boolean",
              "default": false,
              "description": "Montar unidades del dispositivo local: aumenta superficie de ataque; off por defecto."
            },
            "printerRedirection": {
              "type": "boolean",
              "default": false
            },
            "smartSizing": {
              "type": "boolean",
              "default": true,
              "description": "Resolucion adaptable al tamano de ventana/dispositivo."
            },
            "idleDisconnectMinutes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1440,
              "default": 0
            },
            "reconnectRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "default": 5
            }
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "client",
                "fixed"
              ],
              "default": "client"
            },
            "width": {
              "type": "integer",
              "minimum": 800,
              "maximum": 5120
            },
            "height": {
              "type": "integer",
              "minimum": 600,
              "maximum": 2880
            },
            "refreshHz": {
              "type": "integer",
              "minimum": 24,
              "maximum": 240
            }
          }
        }
      }
    },
    "gaming": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "channel": {
          "enum": [
            "rdp",
            "moonlight",
            "both"
          ],
          "default": "both",
          "description": "rdp = solo Windows App (escritorio). moonlight = anadira Sunshine+Moonlight (canal de juego). both = ambos."
        },
        "performancePreset": {
          "enum": [
            "compatibilidad",
            "equilibrado",
            "calidad",
            "competitivo"
          ],
          "default": "equilibrado"
        },
        "sunshine": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "httpsPort": {
              "type": "integer",
              "minimum": 1024,
              "maximum": 65535,
              "default": 47990
            },
            "fps": {
              "type": "integer",
              "enum": [
                30,
                60,
                90,
                120
              ],
              "default": 60
            },
            "codec": {
              "enum": [
                "auto",
                "h264",
                "hevc",
                "av1"
              ],
              "default": "auto"
            },
            "bitrateMbps": {
              "type": "integer",
              "minimum": 2,
              "maximum": 150,
              "default": 25
            },
            "encoder": {
              "enum": [
                "auto",
                "nvenc",
                "amf",
                "qsv",
                "software"
              ],
              "default": "auto",
              "description": "software = x264, solo como respaldo; el auditor lo advierte."
            },
            "audio": {
              "type": "boolean",
              "default": true
            },
            "allowedCidrs": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string"
              }
            },
            "keepConsoleSession": {
              "type": "boolean",
              "default": true,
              "description": "Crea la tarea que devuelve la sesion a la consola (tscon) para que Sunshine pueda capturar la pantalla."
            }
          }
        },
        "touchControls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "profiles": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string"
              },
              "description": "Nombres de ficheros en gaming/profiles (sin .json) que se instalan en la VM."
            },
            "clientSideNote": {
              "type": "boolean",
              "default": true
            }
          }
        },
        "monitoring": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600,
              "default": 5
            },
            "retentionDays": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 7
            },
            "latencyTargetMs": {
              "type": "number",
              "minimum": 1,
              "maximum": 500,
              "default": 40
            }
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selections"
      ],
      "properties": {
        "selections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "enum": [
              "minimal",
              "utilities",
              "gaming",
              "full",
              "custom"
            ]
          },
          "description": "Conjuntos predefinidos de apps/selections/*.json"
        },
        "custom": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "wingetId"
            ],
            "properties": {
              "wingetId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+ -]{1,127}$"
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        },
        "skipUnsupported": {
          "type": "boolean",
          "default": true
        },
        "blockNonOfficialSources": {
          "type": "boolean",
          "default": true
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 2
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defender": {
          "enum": [
            "enable",
            "enable-with-exclusions",
            "inspect-only"
          ],
          "default": "enable",
          "description": "Este proyecto NUNCA desactiva Microsoft Defender ni sus servicios de seguridad."
        },
        "defenderExclusions": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "string"
          }
        },
        "autoUpdates": {
          "enum": [
            "notify",
            "install",
            "install-and-restart-off"
          ],
          "default": "install"
        },
        "screenLockMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 480,
          "default": 0,
          "description": "0 = sin bloqueo (normal en una VM de juego de uso personal."
        },
        "bitlockerDataDisk": {
          "type": "boolean",
          "default": false,
          "description": "Cifrado de D: (requiere guardar la clave de recuperacion FUERA de la VM)."
        },
        "auditLogging": {
          "type": "boolean",
          "default": true
        },
        "disableUnusedServices": {
          "type": "array",
          "maxItems": 30,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PrintNotify",
              "WMPNetworkSvc",
              "lfsvc",
              "WbioSrvc",
              "dmwappushservice",
              "mapsbroker",
              "XblAuthManager",
              "XblGameSave",
              "DiagTrack"
            ]
          },
          "description": "Lista blanca cerrada. Los servicios de seguridad (WinDefend, SecurityHealthService, wuauserv,mpssvc) no pueden aparecer en esta lista: se valida y se rechaza."
        },
        "restrictRdpToAdministrators": {
          "type": "boolean",
          "default": true
        },
        "allowSmartCardRedirect": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "power": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plan": {
          "enum": [
            "ultimate-performance",
            "high-performance",
            "balanced"
          ],
          "default": "ultimate-performance"
        },
        "disableSleep": {
          "type": "boolean",
          "default": true
        },
        "disableHibernate": {
          "type": "boolean",
          "default": true
        },
        "hardwareAcceleratedGpuScheduling": {
          "type": "boolean",
          "default": true,
          "description": "HAGS (GPU scheduling): solo tiene efecto con un driver WDDM compatible."
        },
        "disableGameDvr": {
          "type": "boolean",
          "default": false,
          "description": "false deja Game Bar/DVR activos (tiles, captura). true reduce overhead a cambio de perder la captura."
        },
        "processCleanup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false
            },
            "processes": {
              "type": "array",
              "maxItems": 40,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}(\\.exe)?$"
              }
            }
          }
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acknowledgePaidResources"
      ],
      "properties": {
        "acknowledgePaidResources": {
          "const": true,
          "description": "Declaracion obligatoria: azure/aws cobran por VM, disco, GPU, IP y trafico de salida. No existe una VM de gaming gratuita en la nube."
        },
        "budgetUsdPerMonth": {
          "type": "number",
          "minimum": 0
        },
        "autoStop": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "idleMinutes": {
              "type": "integer",
              "minimum": 5,
              "maximum": 1440,
              "default": 30
            },
            "action": {
              "enum": [
                "deallocate",
                "stop",
                "hibernate"
              ],
              "default": "deallocate"
            }
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    }
  }
}
