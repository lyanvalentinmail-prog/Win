  "requisitos": {
    "fuente": "https://store.steampowered.com/app/1145360/HADES/",
    "vcpu": 3,
    "ramGiB": 4,
    "vramGiB": 1,
    "almacenamientoGiB": 15,
    "apiGrafica": "DirectX 11",
