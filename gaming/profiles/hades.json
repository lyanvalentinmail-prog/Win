        "efecto": "Evita que la GPU genere frames de sobra y dispare el bitrate",
        "donde": "dentro-del-juego",
        "automatizable": false
      },
      {
        "clave": "-fullscreen -window-size 1920x1080",
        "valor": "parametros",
