{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lyanvalentinmail-prog/Win/apps/catalog.schema.json",
  "title": "Catalogo de aplicaciones del proyecto Win",
  "description": "Cada entrada describe COMO se instala y COMO se verifica. El instalador real siempre procede del repositorio comunitario de winget (fuente 'winget') o de una URL de la lista apps/sources.json.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "aplicaciones"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "aplicaciones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/app"
      }
    },
    "$schema": {
      "type": "string"
    },
    "snapshotVerificadoEl": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Fecha en que se verifico cada id/URL/hash contra su fuente oficial."
    },
    "comoSeInstala": {
      "type": "string"
    },
    "importante": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nombre",
        "categoria",
        "conjuntos",
        "fuente",
        "instalacion"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{1,127}$",
          "description": "PackageIdentifier exacto de winget (case-insensitive)."
        },
        "nombre": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "categoria": {
          "enum": [
            "utilidad",
            "gaming",
            "navegador",
            "diagnostico",
            "acceso-seguro",
            "canal-juego",
            "runtime"
          ]
        },
        "conjuntos": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "minimal",
              "utilities",
              "gaming",
              "full"
            ]
          },
          "description": "Seleccion de apps en la que aparece esta aplicacion. 'custom' nunca se referencia aqui."
        },
        "descripcion": {
          "type": "string",
          "maxLength": 280
        },
        "fuente": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "oficial"
          ],
          "properties": {
            "oficial": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "description": "Pagina oficial del fabricante."
            },
            "descargaDirecta": {
              "type": "string",
              "pattern": "^https://",
              "description": "URL del instalador, si se documenta. Su host debe estar en apps/sources.json."
            },
            "nota": {
              "type": "string",
              "maxLength": 280
            }
          }
        },
        "instalacion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "metodo"
          ],
          "properties": {
            "metodo": {
              "enum": [
                "winget",
                "store",
                "manual",
                "no-instalar"
              ],
              "description": "store/manual no se automatizan: el bootstrap los registra como 'pendiente de accion del usuario'."
            },
            "silentFlags": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "string"
              }
            },
            "version": {
              "type": "string",
              "description": "Version fijada (pin). Vaciar para 'la mas reciente del repositorio'."
            },
            "scope": {
              "enum": [
                "user",
                "machine"
              ],
              "default": "machine"
            },
            "arch": {
              "enum": [
                "x64",
                "x86",
                "arm64",
                "neutral"
              ],
              "default": "x64"
            },
            "nota": {
              "type": "string",
              "maxLength": 300
            },
            "versionObservada": {
              "type": "string",
              "description": "Version observada en microsoft/winget-pkgs en la fecha del snapshot (informativa)."
            }
          }
        },
        "verificacion": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "firmanteEsperado": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string"
              },
              "description": "Prefijos admitidos del Subject del certificado Authenticode del ejecutable instalado."
            },
            "ejecutableRuta": {
              "type": "string",
              "description": "Ruta (con variables de entorno) del binario que se comprueba tras instalar."
            },
            "installerSha256": {
              "type": "string",
              "pattern": "^([a-fA-F0-9]{64})?$",
              "description": "SHA-256 del instalador declarado por winget-pkgs (mayusculas o minusculas). Vacio = se consulta en la ejecucion."
            },
            "comprobarFirmaPostInstalacion": {
              "type": "boolean",
              "default": true
            },
            "nota": {
              "type": "string",
              "maxLength": 400
            }
          }
        },
        "compatibilidad": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ediciones": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string"
              },
              "description": "Ediciones de Windows donde se ha verificado. [] = todas."
            },
            "requiereGpu": {
              "type": "boolean",
              "default": false
            },
            "requiereStore": {
              "type": "boolean",
              "default": false
            },
            "requiereVramGiB": {
              "type": "number",
              "minimum": 0
            },
            "bloqueadoEnVm": {
              "type": "boolean",
              "default": false,
              "description": "true si el fabricante o su antitrampas impiden VM. El bootstrap la omite y avisa; no la instala 'a la fuerza'."
            },
            "nota": {
              "type": "string",
              "maxLength": 900
            }
          }
        },
        "postInstalacion": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "enum": [
              "crear-carpeta-juegos",
              "fijar-biblioteca-steam",
              "iniciar-como-servicio",
              "quitar-de-autostart",
              "anadir-al-escritorio",
              "aplicar-perfil-controles",
              "crear-carpeta-capturas"
            ]
          },
          "description": "Hooks soportados por scripts/win/Install-Apps.ps1. Cualquier otro valor es error de schema."
        },
        "riesgos": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
